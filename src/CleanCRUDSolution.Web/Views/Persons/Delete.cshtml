@model DeletePersonViewModel
@{
	ViewBag.Title = "Delete Person";
}

<div class="container">
  <a asp-controller="Persons" asp-action="Index" class="link-muted">Back to Persons List</a>

  <section class="page-header">
	<div class="header-inner">
	  <h1>Delete Person</h1>
	</div>
  </section>

  <div asp-validation-summary="All"></div>

  <div class="card" style="max-width:720px;padding:20px">
	<form asp-controller="Persons" asp-action="Delete" asp-route-personId="" method="post">
	  <input type="hidden" asp-for="PersonData.Id" />

	  <div style="display:grid;grid-template-columns:1fr;gap:12px">
		<label asp-for="PersonData.PersonName">Person Name</label>
		<input asp-for="PersonData.PersonName" class="form-input" disabled />
		<input type="hidden" asp-for="PersonData.PersonName" />

		<label asp-for="PersonData.Email">Email</label>
		<input asp-for="PersonData.Email" class="form-input" disabled />
		<input type="hidden" asp-for="PersonData.Email" />

		<label asp-for="PersonData.DateOfBirth">Date Of Birth</label>
		<input asp-for="PersonData.DateOfBirth" class="form-input" disabled />
		<input type="hidden" asp-for="PersonData.DateOfBirth" />

		<label>Gender</label>
		<div>
		  <input type="hidden" asp-for="PersonData.Gender" />
		  @foreach(var gender in Model.GenderOptions)
		  {
			  var uniqueId = $"persondata_gender_{gender.Value}";
			  <input id="@uniqueId" type="radio" asp-for="PersonData.Gender" value="@gender.Value" disabled />
			  <label for="@uniqueId" style="margin-right:12px">@gender.Text</label>
		  }
		</div>

		<label asp-for="PersonData.CountryId">Country</label>
		<select asp-for="PersonData.CountryId" asp-items="Model.CountryOptions" class="form-input" disabled>
		  <option value="">Select</option>
		</select>
		<input type="hidden" asp-for="PersonData.CountryId" />

		<label asp-for="PersonData.Address">Address</label>
		<textarea asp-for="PersonData.Address" class="form-input" rows="3" disabled></textarea>
		<input type="hidden" asp-for="PersonData.Address" />

		<div style="display:flex;align-items:center;gap:8px">
		  <input asp-for="PersonData.ReceiveNewsLetters" disabled />
		  <label asp-for="PersonData.ReceiveNewsLetters">Receive News Letter</label>
		  <input type="hidden" asp-for="PersonData.ReceiveNewsLetters" />
		</div>

		<div>
		  <button type="submit" class="btn btn-danger">Delete</button>
		</div>
	  </div>
	</form>
  </div>
</div>