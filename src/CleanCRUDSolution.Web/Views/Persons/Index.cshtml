@model ViewPersonsViewModel
@{
    ViewBag.Title = "Persons";
}

<div class="container">
  <section class="page-header">
    <div class="header-inner">
      <h1>People</h1>
      <div class="actions">
        <a asp-controller="Persons" asp-action="Create" class="btn btn-primary">New Person</a>
        <div class="export">
          <a asp-controller="Persons" asp-action="PersonsCSV" target="_blank" class="btn btn-ghost">CSV</a>
          <a asp-controller="Persons" asp-action="PersonsExcel" target="_blank" class="btn btn-ghost">Excel</a>
          <a asp-controller="Persons" asp-action="PersonsPDF" target="_blank" class="btn btn-ghost">PDF</a>
        </div>
      </div>
    </div>
  </section>

  <form asp-controller="Persons" asp-action="Index" method="get" class="search-form">
    <div class="search-grid">
      <select asp-for="SearchRequest.SearchColumn" class="form-input">
        @foreach (var searchOption in Model.SearchOptions)
        {
            if (searchOption.Value == Model.SearchRequest.SearchColumn?.ToString())
            {
                <option value="@searchOption.Value" selected>@searchOption.Text</option>
            }
            else
            {
                <option value="@searchOption.Value">@searchOption.Text</option>
            }
        }
      </select>

      <input asp-for="SearchRequest.SearchTerm" type="search" class="form-input" placeholder="Search people, email or country" />

      <div class="search-actions">
        <button class="btn btn-primary" type="submit">Search</button>
        <a asp-controller="Persons" asp-action="Index" class="link-muted">Clear</a>
      </div>
    </div>
  </form>

  <table class="person-table">
    <thead>
      <tr>
        @foreach(var option in Model.SearchOptions)
        {
                var partialModel = new ViewPersonsColumnHeaderViewModel();
                partialModel.SearchRequest = Model.SearchRequest;
                partialModel.Column = option;
            <th><partial name="_GridColumnHeader" model="partialModel" /></th>
        }
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var person in Model.Persons)
      {
        <tr>
          <td>@person.Name</td>
          <td>@person.Email</td>
          <td>@person.DateOfBirth?.ToString("dd MM yyyy")</td>
          <td>@person.Age</td>
          <td>@person.Gender</td>
          <td>@person.CountryName</td>
          <td>@person.Address</td>
          <td>@person.ReceiveNewsLetters</td>
          <td class="actions-cell">
            <a asp-controller="Persons" asp-action="Edit" asp-route-personId="@person.Id" class="action-link">Edit</a>
            <a asp-controller="Persons" asp-action="Delete" asp-route-personId="@person.Id" class="action-link danger">Delete</a>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>
