@model UpdatePersonViewModel
@{
    ViewBag.Title = "Edit Person";
}

<div class="container">
  <a asp-controller="Persons" asp-action="Index" class="link-muted">Back to Persons List</a>

  <section class="page-header">
    <div class="header-inner">
      <h1>Edit Person</h1>
    </div>
  </section>

  <div asp-validation-summary="All"></div>

  <div class="card" style="max-width:720px;padding:20px">
    <form id="EditPersonForm" asp-controller="Persons" asp-action="Edit" asp-route-personId="" method="post">
      <input type="hidden" asp-for="PersonData.Id" />

      <div style="display:grid;grid-template-columns:1fr;gap:12px">
        <label asp-for="PersonData.PersonName">Person Name</label>
        <input asp-for="PersonData.PersonName" disabled class="form-input" />
        <input type="hidden" asp-for="PersonData.PersonName" />
        <span asp-validation-for="PersonData.PersonName" class="text-red"></span>

        <label asp-for="PersonData.Email">Email</label>
        <input asp-for="PersonData.Email" class="form-input" />
        <span asp-validation-for="PersonData.Email" class="text-red"></span>

        <label asp-for="PersonData.DateOfBirth">Date Of Birth</label>
        <input asp-for="PersonData.DateOfBirth" class="form-input" />
        <span asp-validation-for="PersonData.DateOfBirth" class="text-red"></span>

        <label>Gender</label>
        <div>
          @foreach (var gender in Model.GenderOptions)
          {
              var uniqueId = $"persondata_gender_{gender.Value}";
              <input id="@uniqueId" type="radio" asp-for="PersonData.Gender" value="@gender.Value" />
              <label for="@uniqueId" style="margin-right:12px">@gender.Text</label>
          }
        </div>
        <span asp-validation-for="PersonData.Gender" class="text-red"></span>

        <label asp-for="PersonData.CountryId">Country</label>
        <select asp-for="PersonData.CountryId" asp-items="Model.CountryOptions" class="form-input">
          <option value="">Select</option>
        </select>
        <span asp-validation-for="PersonData.CountryId" class="text-red"></span>

        <label asp-for="PersonData.Address">Address</label>
        <textarea asp-for="PersonData.Address" class="form-input" rows="3"></textarea>
        <span asp-validation-for="PersonData.Address" class="text-red"></span>

        <div style="display:flex;align-items:center;gap:8px">
          <input asp-for="PersonData.ReceiveNewsLetters" class="" />
          <label asp-for="PersonData.ReceiveNewsLetters">Receive News Letter</label>
        </div>

        <div>
          <button type="submit" id="UpdatePersonBtn" class="btn btn-primary">Update</button>
        </div>
      </div>
    </form>
  </div>
</div>