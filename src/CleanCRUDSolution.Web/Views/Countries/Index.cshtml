@model UploadCountriesViewModel
@{
    ViewBag.Title = "Upload Countries from Excel";
}

<div class="container">
  <section class="page-header">
    <div class="header-inner">
      <h1>Upload Countries from Excel</h1>
    </div>
  </section>

  @if (!string.IsNullOrWhiteSpace(Model.ReportOutcome) || Model.PersistedItemsCount.HasValue)
  {
      <div class="alert alert-success" role="status" style="margin-bottom:12px">
          @if(Model.PersistedItemsCount.HasValue)
          {
              <div><strong>@(Model.PersistedItemsCount)</strong> countries have been uploaded successfully.</div>
          }
          <div><strong>@Model.ReportOutcome</strong></div>
          <div>@Model.ReportOutcomeReason</div>
      </div>
  }

  <div class="card">
    <form asp-action="Index" asp-controller="Countries" enctype="multipart/form-data" method="post">
      <div style="max-width:560px;padding:18px">
        <label class="form-label" for="FormFile">Choose an xlsx file</label>
        <input asp-for="FormFile" class="form-input" type="file" id="FormFile" />
        <span asp-validation-for="FormFile" class="text-red" style="display:block;margin-top:6px"></span>

        <div style="margin-top:16px">
          <button type="submit" class="btn btn-primary">Upload</button>
        </div>
      </div>
    </form>
  </div>
</div>